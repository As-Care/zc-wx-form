/* 展晨门窗 商品详情与尺寸算价器 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
}

.cover-box {
  width: 100%;
  height: 380rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 24rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(to top, rgba(15, 23, 42, 0.95), transparent);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.product-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 10rpx;
}

.base-tag {
  font-size: 22rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.18);
  border: 1rpx solid rgba(197, 168, 128, 0.4);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  display: inline-block;
  white-space: nowrap;
}

.desc-text {
  font-size: 24rpx;
  color: #CBD5E1;
  line-height: 1.6;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.min-area-tip {
  font-size: 20rpx;
  color: #EAB308;
}

/* 多套定制 垂直列表 (一套一行，允许换行) */
.sets-tab-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.sets-header {
  margin-bottom: 20rpx;
  align-items: center;
}

.add-set-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #121316;
  background: linear-gradient(135deg, #D4AF37 0%, #C5A880 100%);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(197, 168, 128, 0.35);
}

.sets-vertical-list {
  gap: 16rpx;
  width: 100%;
}

.set-item-row {
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(26, 29, 36, 0.7);
  border: 1rpx solid rgba(197, 168, 128, 0.18);
  box-sizing: border-box;
  align-items: center;
  transition: all 0.25s ease;
}

.set-item-row.active {
  background: rgba(197, 168, 128, 0.15);
  border-color: #C5A880;
  box-shadow: 0 4rpx 16rpx rgba(197, 168, 128, 0.2);
}

.set-row-left {
  flex: 1;
  align-items: center;
  margin-right: 16rpx;
}

.set-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.18);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.set-label-text {
  font-size: 26rpx;
  color: #F5F5F7;
  font-weight: 600;
  word-break: break-all;
  white-space: normal;
  line-height: 1.35;
}

.set-row-right {
  align-items: center;
  flex-shrink: 0;
}

.active-tag {
  font-size: 20rpx;
  color: #C5A880;
  font-weight: 700;
  margin-right: 12rpx;
}

.set-del-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.15);
  color: #EF4444;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

/* 长条尺寸与备注输入框样式 (Label 统一固定 120rpx 宽度) */
.full-input-row {
  margin-bottom: 24rpx;
  align-items: center;
}

.dim-label {
  font-size: 26rpx;
  color: #CBD5E1;
  width: 120rpx; /* 修改为 120rpx 宽度 */
  flex-shrink: 0;
}

.full-input-box {
  flex: 1;
  margin-left: 16rpx;
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  align-items: center;
  box-sizing: border-box;
}

.full-dim-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #C5A880;
  text-align: right;
  height: 52rpx;
  line-height: 52rpx;
}

.left-align {
  text-align: left !important;
}

.unit-text {
  font-size: 24rpx;
  color: #94A3B8;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.area-summary-box {
  background: rgba(15, 23, 42, 0.6);
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  margin-top: 12rpx;
  border: 1rpx dashed rgba(197, 168, 128, 0.3);
}

.area-item {
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
}

.a-label {
  font-size: 22rpx;
  color: #94A3B8;
  white-space: nowrap;
}

.a-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-top: 6rpx;
  white-space: nowrap;
}

.area-line {
  width: 1rpx;
  height: 50rpx;
  background: rgba(148, 163, 184, 0.2);
}

.option-list {
  margin-top: 16rpx;
}

.option-item {
  padding: 16rpx;
  background: rgba(15, 23, 42, 0.5);
  border: 1rpx solid rgba(148, 163, 184, 0.15);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s ease;
}

.option-item.active {
  background: rgba(197, 168, 128, 0.12);
  border-color: #C5A880;
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #94A3B8;
  margin-right: 16rpx;
  position: relative;
}

.radio-circle.checked {
  border-color: #C5A880;
  background: #C5A880;
}

.radio-circle.checked::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0F172A;
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}

.opt-name {
  font-size: 24rpx;
  color: #F8FAFC;
}

.opt-price {
  font-size: 22rpx;
  color: #C5A880;
}

/* 底部常驻悬浮报价条 */
.floating-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.96);
  border-top: 1rpx solid rgba(197, 168, 128, 0.25);
  backdrop-filter: blur(16px);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.price-preview {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

.p-sub {
  font-size: 20rpx;
  color: #94A3B8;
}

.p-sym {
  font-size: 26rpx;
  color: #C5A880;
  font-weight: 700;
}

.p-val {
  font-size: 40rpx;
  font-weight: 900;
  color: #C5A880;
  margin-left: 6rpx;
}

.submit-btn {
  font-size: 28rpx;
  font-weight: 700;
  height: 84rpx;
  padding: 0 44rpx;
  margin: 0 !important;
  margin-left: auto !important;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 高奢【下单预览】弹窗样式 (完全对齐与完美盒模型) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(14px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  padding: 30rpx;
  box-sizing: border-box;
}

.modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-card {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  background: rgba(26, 29, 36, 0.98);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8), 0 0 30rpx rgba(197, 168, 128, 0.15);
  transform: scale(0.92) translateY(30rpx);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-mask.show .modal-card {
  transform: scale(1) translateY(0);
}

.modal-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(197, 168, 128, 0.2);
  align-items: center;
  flex-shrink: 0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #F5F5F7;
  letter-spacing: 1rpx;
}

/* 弹窗关闭 Icon 完美绝对居中 */
.close-icon-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(154, 158, 167, 0.15);
  color: #9A9EA7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.modal-scroll-body {
  flex: 1;
  max-height: 46vh;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.modal-section {
  gap: 10rpx;
}

.set-title-badge {
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}

.set-b-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #C5A880;
  word-break: break-all;
  white-space: normal;
  max-width: 360rpx;
}

.set-b-price {
  font-size: 22rpx;
  font-weight: 700;
  color: #F5F5F7;
}

.modal-row {
  margin-bottom: 10rpx;
  align-items: center;
}

.m-label {
  font-size: 24rpx;
  color: #9A9EA7;
}

.m-val {
  font-size: 24rpx;
  color: #F5F5F7;
  font-weight: 500;
}

.bold-text {
  font-weight: 700;
}

.gold-text {
  color: #C5A880;
  font-weight: 700;
}

.m-divider {
  height: 1rpx;
  background: rgba(154, 158, 167, 0.15);
  margin: 16rpx 0;
  width: 100%;
}

.m-opt-item {
  margin-bottom: 8rpx;
  align-items: center;
}

.m-opt-name {
  font-size: 22rpx;
  color: #CBD5E1;
}

.m-opt-price {
  font-size: 22rpx;
  color: #C5A880;
}

.modal-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(197, 168, 128, 0.2);
  width: 100%;
  flex-shrink: 0;
}

.total-section {
  background: rgba(197, 168, 128, 0.12);
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  margin-bottom: 16rpx;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.m-total-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #F5F5F7;
}

.m-sub-label {
  font-size: 20rpx;
  color: #9A9EA7;
  margin-top: 4rpx;
}

.m-total-price-box {
  align-items: baseline;
}

.m-total-sym {
  font-size: 26rpx;
  color: #C5A880;
  font-weight: 700;
}

.m-total-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #C5A880;
  margin-left: 6rpx;
}

.confirm-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.confirm-btn::after {
  border: none;
}
