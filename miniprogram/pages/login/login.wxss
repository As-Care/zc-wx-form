/* 展晨门窗 完善个人资料与登录 WXSS (黑曜石高奢风格) */

.container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  justify-content: space-between;
}

.logo-section {
  align-items: center;
  margin-top: 20rpx;
}

.app-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #F5F5F7;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.app-subtitle {
  font-size: 24rpx;
  color: #C5A880;
}

.profile-section {
  align-items: center;
  width: 100%;
  margin: 30rpx 0;
}

.required-star {
  color: #EF4444;
  margin-left: 4rpx;
  font-weight: 700;
}

/* 中间正圆形头像按钮 */
.avatar-box {
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  width: 180rpx !important;
  height: 180rpx !important;
  min-width: 180rpx !important;
  min-height: 180rpx !important;
  max-width: 180rpx !important;
  max-height: 180rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  background: rgba(26, 29, 36, 0.9);
  border: 4rpx solid #C5A880;
  box-shadow: 0 8rpx 32rpx rgba(197, 168, 128, 0.3);
  overflow: hidden;
  flex-shrink: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.avatar-wrapper::after {
  border: none !important;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.camera-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.placeholder-tip {
  font-size: 18rpx;
  color: #9A9EA7;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9A9EA7;
}

/* 头像下方姓名表单 */
.nickname-form {
  width: 100%;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #C5A880;
  margin-bottom: 14rpx;
}

.nickname-input-wrap {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.nickname-input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: #F5F5F7;
}

/* 底部保存按钮及编辑模式提示 */
.action-section {
  width: 100%;
  margin-bottom: 40rpx;
  align-items: center;
}

.save-btn {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 0;
}

.edit-notice-tip {
  font-size: 22rpx;
  color: #9A9EA7;
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.4;
  padding: 0 20rpx;
}
