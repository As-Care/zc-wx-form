/* 展晨门窗 新增/编辑地址 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.form-card {
  padding: 28rpx;
  border-radius: 20rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #CBD5E1;
  display: block;
  margin-bottom: 12rpx;
}

.field-input {
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #F8FAFC;
}

.picker-input {
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #F8FAFC;
}

.field-textarea {
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #F8FAFC;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}

.divider {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.15);
  margin: 24rpx 0;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.switch-sub {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 6rpx;
}

.floating-btn-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(197, 168, 128, 0.25);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 24rpx 32rpx calc(24rpx + constant(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.save-btn {
  width: 100% !important;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  margin: 0;
}