/* 展晨门窗 联系我们与接单员列表 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.address-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-header {
  margin-bottom: 16rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #C5A880;
}

.address-body {
  width: 100%;
}

.address-text {
  font-size: 26rpx;
  color: #F5F5F7;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.hours-text {
  font-size: 22rpx;
  color: #9A9EA7;
}

.receivers-list {
  display: flex;
  flex-direction: column;
}

.receiver-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 顶行：姓名 + 电话 */
.receiver-header-row {
  width: 100%;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(197, 168, 128, 0.15);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.receiver-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #F5F5F7;
}

.receiver-phone-box {
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 10rpx 24rpx;
  border-radius: 36rpx;
}

.receiver-phone {
  font-size: 26rpx;
  color: #C5A880;
  font-weight: 700;
  margin-left: 8rpx;
}

/* 下方：宽度 80% 居中二维码 */
.receiver-qr-box {
  width: 100%;
  align-items: center;
  justify-content: center;
}

.qr-img-large {
  width: 80%;
  border-radius: 20rpx;
  border: 2rpx solid #C5A880;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.4);
}

.qr-label {
  font-size: 22rpx;
  color: #C5A880;
  font-weight: 600;
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin: 10rpx 0 20rpx 0;
}

.empty-receiver-box {
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  text-align: center;
}

.empty-tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 10rpx;
}

.empty-tip-sub {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
}

.call-btn {
  width: 90%;
  height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.mt-3 { margin-top: 24rpx; }
.mb-2 { margin-bottom: 16px; }
