<!-- 展晨门窗 联系我们与接单员列表 WXML -->
<view class="container">

  <!-- 第一行：门店官方地址卡片 (点击调用腾讯地图导航) -->
  <view class="glass-card address-card flex-column" bindtap="openStoreLocation">
    <view class="card-header flex-row">
      <view class="location-icon">📍</view>
      <view class="card-title">{{storeInfo.name || '展晨门窗'}} · 官方门店地址</view>
    </view>
    <view class="address-body flex-column">
      <view class="address-text flex-row" style="align-items: center; white-space: nowrap; overflow: hidden;">
        <text class="addr-detail-str" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{storeInfo.address}}</text>
        <text class="hand-nav-icon" style="font-size: 26rpx; color: #C5A880; margin-left: 4rpx; flex-shrink: 0;">👈</text>
      </view>
      <view class="hours-text">营业时间：{{storeInfo.business_hours || '08:30 - 18:30'}}</view>
    </view>
  </view>

  <!-- 接单员列表 (动态渲染后台配好的接单员) -->
  <view class="section-title mb-2">专属接单客服顾问</view>

  <view class="receivers-list" wx:if="{{receivers && receivers.length > 0}}">
    <view class="receiver-card glass-card flex-column" wx:for="{{receivers}}" wx:key="id">
      <!-- 顶行：姓名与电话 -->
      <view class="receiver-header-row flex-between">
        <view class="receiver-name">{{item.name}}</view>
        <view class="receiver-phone-box flex-row" bindtap="callReceiver" data-phone="{{item.phone}}">
          <view class="phone-icon">📞</view>
          <view class="receiver-phone">{{item.phone}}</view>
        </view>
      </view>

      <!-- 下方：宽度80%居中二维码 -->
      <view class="receiver-qr-box flex-column" bindtap="previewQR" data-url="{{item.qr_code_url}}" wx:if="{{item.qr_code_url}}">
        <image class="qr-img-large" src="{{item.qr_code_url}}" mode="widthFix" show-menu-by-longpress="true"></image>
        <view class="qr-label">长按识别二维码加好友</view>
      </view>
    </view>
  </view>

  <view class="empty-receiver-box glass-card flex-column flex-center" wx:else>
    <view class="empty-tip-title">专人接单客服服务中</view>
    <view class="empty-tip-sub">如需定制测量与报价咨询，请直接拨打官方电话</view>
    <view class="call-btn btn-gold flex-center mt-3" bindtap="callStore">拨打官方电话：{{storeInfo.phone || '13545941637'}}</view>
  </view>

</view>
