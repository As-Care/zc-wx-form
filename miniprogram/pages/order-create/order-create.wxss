/* 展晨门窗 确认定制订单 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 20rpx;
  display: block;
}

.item-preview-box {
  background: rgba(18, 20, 24, 0.75);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.22);
}

.prod-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.set-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.15);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.spec-row {
  margin-bottom: 10rpx;
}

.s-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.s-val {
  font-size: 24rpx;
  color: #CBD5E1;
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: rgba(197, 168, 128, 0.15);
  margin: 16rpx 0;
}

.sub-title {
  font-size: 22rpx;
  color: #94A3B8;
}

.opt-tag-list {
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.opt-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  display: inline-flex;
  align-items: center;
}

.opt-tag-img {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
  flex-shrink: 0;
}

.scene-preview-sec {
  margin-top: 24rpx;
}

.scene-remark-sec {
  margin-top: 24rpx;
}

.sec-title {
  margin-bottom: 14rpx;
  display: block;
}

.scene-img-grid {
  flex-wrap: wrap;
  gap: 16rpx;
}

.scene-thumb-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.35);
}

.remark-text-box {
  font-size: 24rpx;
  color: #F8FAFC;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
  display: block;
}

.pick-addr-btn {
  font-size: 22rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 24rpx;
  color: #CBD5E1;
  display: block;
  margin-bottom: 8rpx;
}

.field-input {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #F8FAFC;
}

.field-textarea {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #F8FAFC;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

/* 现场图片上传布局 */
.img-upload-grid {
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.img-thumb-box {
  width: 140rpx;
  height: 140rpx;
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
}

.img-thumb {
  width: 100%;
  height: 100%;
}

.img-del-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.85);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.img-add-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(197, 168, 128, 0.4);
  background: rgba(197, 168, 128, 0.08);
  justify-content: center;
  align-items: center;
}

.add-icon {
  font-size: 40rpx;
  color: #C5A880;
  line-height: 1;
}

.add-text {
  font-size: 20rpx;
  color: #C5A880;
  margin-top: 6rpx;
}

.floating-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.96);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid rgba(197, 168, 128, 0.35);
  padding: 20rpx 30rpx;
  padding-bottom: 40rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.t-sub {
  font-size: 20rpx;
  color: #94A3B8;
}

.t-main {
  align-items: baseline;
}

.t-sym {
  font-size: 24rpx;
  color: #C5A880;
  font-weight: 700;
  margin-right: 4rpx;
}

.t-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #C5A880;
}

.confirm-btn {
  margin: 0 !important;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mb-3 { margin-bottom: 16rpx; }
.mb-1 { margin-bottom: 8rpx; }
