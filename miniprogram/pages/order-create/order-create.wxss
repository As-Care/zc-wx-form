/* 展晨门窗 确认定制订单 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 20rpx;
  display: block;
}

.item-preview-box {
  background: rgba(18, 20, 24, 0.75);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.22);
}

.prod-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.set-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.15);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.spec-row {
  margin-bottom: 10rpx;
}

.s-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.s-val {
  font-size: 24rpx;
  color: #CBD5E1;
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: rgba(197, 168, 128, 0.15);
  margin: 16rpx 0;
}

.sub-title {
  font-size: 22rpx;
  color: #94A3B8;
}

.opt-tag-list {
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.opt-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  display: inline-flex;
  align-items: center;
}

.opt-tag-img {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
  flex-shrink: 0;
}

.pick-addr-btn {
  font-size: 22rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 24rpx;
  color: #CBD5E1;
  display: block;
  margin-bottom: 8rpx;
}

.field-input {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #F8FAFC;
}

.field-textarea {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #F8FAFC;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

.floating-submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.96);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid rgba(197, 168, 128, 0.35);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  padding: 20rpx 30rpx calc(20rpx + constant(safe-area-inset-bottom));
  z-index: 100;
}

.t-sub {
  font-size: 20rpx;
  color: #94A3B8;
}

.t-main {
  align-items: baseline;
}

.t-sym {
  font-size: 24rpx;
  color: #C5A880;
  font-weight: 700;
  margin-right: 4rpx;
}

.t-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #C5A880;
}

.confirm-btn {
  margin: 0;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
}

.mb-3 { margin-bottom: 16rpx; }
.mb-1 { margin-bottom: 8rpx; }
