<!-- 展晨门窗 确认预约订单 WXML -->
<view class="container">

  <!-- 清单汇总卡片 -->
  <view class="glass-card summary-card">
    <text class="card-title">① 门窗定制规格明细</text>
    <view class="item-preview-box">
      <view class="prod-title">{{draft.product_name}}</view>
      <view class="spec-row flex-between">
        <text class="s-label">输入尺寸 (宽 × 高)</text>
        <text class="s-val">{{draft.width_mm}} × {{draft.height_mm}} mm</text>
      </view>
      <view class="spec-row flex-between">
        <text class="s-label">实际算得面积</text>
        <text class="s-val">{{draft.calcResult.actualArea}} ㎡</text>
      </view>
      <view class="spec-row flex-between">
        <text class="s-label">计费面积 (起步底线 {{draft.min_area}}㎡)</text>
        <text class="s-val theme-gold-text">{{draft.calcResult.billedArea}} ㎡</text>
      </view>

      <view class="divider"></view>
      <text class="sub-title">已选配置：</text>
      <view class="opt-tag-list flex-row">
        <text class="opt-tag" wx:for="{{draft.selected_options}}" wx:key="id">{{item.option_name}}</text>
      </view>
    </view>
  </view>

  <!-- 客户测量地址信息表单 -->
  <view class="glass-card form-card">
    <text class="card-title">② 预约上门测量及联系信息</text>

    <view class="form-group">
      <text class="field-label">联系人姓名</text>
      <input class="field-input" placeholder="请输入您的姓名 (如: 张先生)" value="{{customer_name}}" bindinput="onNameInput" />
    </view>

    <view class="form-group">
      <text class="field-label">联系电话</text>
      <input class="field-input" type="number" placeholder="请输入您的手机号" value="{{customer_phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-group">
      <text class="field-label">安装/测量详细地址</text>
      <input class="field-input" placeholder="请输入小区/栋数/门牌号 (如: 仙桃市新天地8栋1202)" value="{{install_address}}" bindinput="onAddressInput" />
    </view>

    <view class="form-group">
      <text class="field-label">现场照片/备注说明</text>
      <textarea class="field-textarea" placeholder="填写特殊要求或现场情况 (如: 需要带高楼吊装绳、封阳台需拆旧窗)" value="{{customer_remark}}" bindinput="onRemarkInput" />
    </view>

  </view>

  <!-- 提示 -->
  <view class="tip-box flex-row">
    <text class="tip-icon">ℹ️</text>
    <text class="tip-text">提交预约订单后，展晨测量师傅将会在 24 小时内联系您并上门精准测量。</text>
  </view>

  <!-- 底部固定提交栏 -->
  <view class="floating-submit-bar flex-between">
    <view class="total-box flex-column">
      <text class="t-sub">预计算得总价</text>
      <view class="t-main flex-row">
        <text class="t-sym">¥</text>
        <text class="t-val">{{draft.calcResult.totalPrice}}</text>
      </view>
    </view>
    <button class="confirm-btn btn-gold" bindtap="submitOrder">确认提交预约 ›</button>
  </view>

</view>
