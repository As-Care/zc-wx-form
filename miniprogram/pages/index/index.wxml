<!-- 展晨门窗 极奢首页 WXML -->
<view class="container">

  <!-- 顶部 Header & 弹性搜索栏 -->
  <view class="header-section flex-row">
    <image class="brand-logo-sq" src="https://zc-oss.carelife.top/common/zc-logo.jpg" mode="aspectFill"></image>
    <view class="search-bar flex-row">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索系统门窗、推拉门..." placeholder-style="color:#64748B;" />
    </view>
  </view>

  <!-- 炫酷 3D 缩放卡片 Banner 轮播 -->
  <swiper 
    class="banner-swiper" 
    autoplay 
    circular 
    interval="4000" 
    duration="500"
    previous-margin="24rpx" 
    next-margin="24rpx" 
    bindchange="onBannerChange"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="swiper-card-box {{bannerIndex === index ? 'active' : ''}}">
        <view class="swiper-card">
          <image class="banner-img" src="{{item.image}}" mode="aspectFill"></image>
          <view class="banner-mask">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-subtitle">{{item.subtitle}}</text>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 炫酷指示器 -->
  <view class="indicator-bar flex-row">
    <view class="dot {{bannerIndex === index ? 'active' : ''}}" wx:for="{{banners}}" wx:key="id"></view>
  </view>

  <!-- 金刚区分类入口 -->
  <view class="grid-section flex-between">
    <view class="grid-item flex-column" wx:for="{{categories}}" wx:key="id" bindtap="navToCategory" data-id="{{item.id}}">
      <view class="icon-circle">
        <image class="cat-icon" src="{{item.icon_url}}"></image>
      </view>
      <text class="cat-name">{{item.sub_title || item.name}}</text>
    </view>
  </view>

  <!-- 20年实力背书 Banner -->
  <view class="glass-card brand-badge-card flex-between">
    <view class="badge-item flex-column">
      <text class="badge-num">20+</text>
      <text class="badge-label">年专业经验</text>
    </view>
    <view class="badge-line"></view>
    <view class="badge-item flex-column">
      <text class="badge-num">50000+</text>
      <text class="badge-label">成功案例</text>
    </view>
    <view class="badge-line"></view>
    <view class="badge-item flex-column">
      <text class="badge-num">ISO9001</text>
      <text class="badge-label">质量体系认证</text>
    </view>
  </view>

  <!-- 热门爆款推荐 -->
  <view class="section-header flex-between">
    <text class="section-title">热门定制推荐</text>
    <text class="section-more" bindtap="navToCategory">查看全部 ›</text>
  </view>

  <view class="product-grid">
    <view class="product-card glass-card" wx:for="{{products}}" wx:key="id" bindtap="navToDetail" data-id="{{item.id}}">
      <image class="product-img" src="{{item.cover_image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-desc">{{item.description}}</text>
        <view class="product-price-bar flex-between">
          <view class="price-box">
            <text class="currency">¥</text>
            <text class="price-val">{{item.base_price_sqm}}</text>
            <text class="unit">/ ㎡起</text>
          </view>
          <view class="calc-btn btn-gold">定制下单</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 纯粹单按钮：联系我们 -->
  <view class="contact-btn-wrapper">
    <button class="contact-big-btn btn-gold" bindtap="navToContact">联系我们</button>
  </view>

</view>
