/* 展晨门窗 订单详情与流转时间轴 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 顶部状态卡片 (玄武黑曜石高奢设计) */
.status-banner-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.s-text-box {
  flex: 1;
}

.s-header-row {
  align-items: center;
  margin-bottom: 8rpx;
}

.s-badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C5A880;
  box-shadow: 0 0 10rpx #C5A880;
  margin-right: 14rpx;
}

.s-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #C5A880;
}

.s-subtitle {
  font-size: 24rpx;
  color: #CBD5E1;
  line-height: 1.45;
}

/* 时间轴 */
.timeline-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 24rpx;
  display: block;
}

.timeline {
  width: 100%;
  position: relative;
  padding: 10rpx 0;
}

.step-item {
  align-items: center;
  flex: 1;
  position: relative;
  z-index: 2;
}

.node-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.2);
  border: 2rpx solid #64748B;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.node-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #64748B;
}

.step-name {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 10rpx;
}

.step-item.active .node-circle {
  background: rgba(197, 168, 128, 0.2);
  border-color: #C5A880;
  box-shadow: 0 0 12rpx #C5A880;
}

.step-item.active .node-dot {
  background: #C5A880;
}

.step-item.active .step-name {
  color: #C5A880;
  font-weight: 700;
}

/* 特殊收费 */
.special-charge-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(234, 179, 8, 0.08);
  border: 1rpx solid rgba(234, 179, 8, 0.3);
}

.special-content {
  margin-top: 12rpx;
}

.remark-text {
  font-size: 24rpx;
  color: #EAB308;
  margin-bottom: 8rpx;
}

.charge-row {
  align-items: center;
}

.c-label {
  font-size: 22rpx;
  color: #CBD5E1;
}

.c-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #EAB308;
}

/* 门窗多套明细卡片 */
.items-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.item-card {
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(197, 168, 128, 0.2);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-header {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.15);
  margin-bottom: 12rpx;
  align-items: center;
}

.set-label-box {
  align-items: center;
  flex: 1;
  margin-right: 12rpx;
}

.set-idx-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.18);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.p-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #F8FAFC;
  word-break: break-all;
  white-space: normal;
}

.p-subtotal {
  font-size: 24rpx;
  font-weight: 700;
  color: #C5A880;
  flex-shrink: 0;
}

.p-prod-title {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 12rpx;
}

.item-detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.d-text {
  font-size: 22rpx;
  color: #CBD5E1;
}

.opt-breakdown-box {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(148, 163, 184, 0.2);
  gap: 4rpx;
}

.opt-b-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #C5A880;
  margin-bottom: 4rpx;
}

.opt-b-line {
  font-size: 20rpx;
  color: #94A3B8;
  align-items: center;
}

.opt-detail-img {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
  flex-shrink: 0;
}

/* 汇总账单 */
.summary-breakdown {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(197, 168, 128, 0.2);
}

.b-row {
  margin-bottom: 10rpx;
}

.b-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.b-val {
  font-size: 24rpx;
  color: #F8FAFC;
}

.b-total-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(148, 163, 184, 0.2);
}

.bt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.bt-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #C5A880;
}

/* 底部操作 (黑曜石高奢) */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.96);
  border-top: 1rpx solid rgba(197, 168, 128, 0.25);
  backdrop-filter: blur(16px);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  gap: 20rpx;
}

.call-store-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #F8FAFC;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.call-store-btn::after {
  border: none;
}

.nav-back-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.nav-back-btn::after {
  border: none;
}
