/* 展晨门窗 订单详情与流转时间轴 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
}

/* 顶部状态卡片 (玄武黑曜石高奢设计) */
.status-banner-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.s-text-box {
  flex: 1;
}

.s-header-row {
  align-items: center;
  margin-bottom: 8rpx;
}

.s-badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C5A880;
  box-shadow: 0 0 10rpx #C5A880;
  margin-right: 14rpx;
}

.s-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #C5A880;
}

.s-subtitle {
  font-size: 24rpx;
  color: #CBD5E1;
  line-height: 1.45;
}

/* 时间轴 */
.timeline-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 24rpx;
  display: block;
}

.timeline {
  width: 100%;
  position: relative;
  padding: 10rpx 0;
}

.step-item {
  align-items: center;
  flex: 1;
  position: relative;
  z-index: 2;
}

.node-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.2);
  border: 2rpx solid #64748B;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.node-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #64748B;
}

.step-name {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 10rpx;
}

.step-item.active .node-circle {
  background: rgba(197, 168, 128, 0.2);
  border-color: #C5A880;
  box-shadow: 0 0 12rpx #C5A880;
}

.step-item.active .node-dot {
  background: #C5A880;
}

.step-item.active .step-name {
  color: #C5A880;
  font-weight: 700;
}

/* 特殊收费 */
.special-charge-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(234, 179, 8, 0.08);
  border: 1rpx solid rgba(234, 179, 8, 0.3);
}

.special-content {
  margin-top: 12rpx;
}

.remark-text {
  font-size: 24rpx;
  color: #EAB308;
  margin-bottom: 8rpx;
}

.charge-row {
  align-items: center;
}

.c-label {
  font-size: 22rpx;
  color: #CBD5E1;
}

.c-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #EAB308;
}

/* 现场照片与备注卡片 */
.scene-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.scene-img-grid {
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
}

.scene-img-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
}

.scene-remark {
  font-size: 24rpx;
  color: #E2E8F0;
  line-height: 1.5;
}

/* 门窗多套明细卡片 */
.items-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.item-preview-box {
  background: rgba(18, 20, 24, 0.75);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.22);
}

.prod-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.set-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.15);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.spec-row {
  margin-bottom: 10rpx;
}

.s-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.s-val {
  font-size: 24rpx;
  color: #CBD5E1;
  font-weight: 600;
}

.divider {
  height: 1rpx;
  background: rgba(197, 168, 128, 0.15);
  margin: 16rpx 0;
}

.sub-title {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 20rpx;
  display: block;
}

.scene-preview-sec {
  margin-top: 24rpx;
}

.scene-remark-sec {
  margin-top: 24rpx;
}

.sec-title {
  margin-bottom: 14rpx;
  display: block;
}

.scene-img-grid {
  flex-wrap: wrap;
  gap: 16rpx;
}

.scene-thumb-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.35);
}

.remark-text-box {
  font-size: 24rpx;
  color: #F8FAFC;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
  display: block;
}

.opt-breakdown-box {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(148, 163, 184, 0.2);
  gap: 4rpx;
}

/* 客户信息与安装地址卡片 */
.customer-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.c-info-grid {
  gap: 12rpx;
}

.info-row {
  align-items: flex-start;
}

.info-label {
  font-size: 24rpx;
  color: #94A3B8;
  flex-shrink: 0;
  white-space: nowrap;
  width: auto;
  margin-right: 24rpx;
}

.info-val {
  font-size: 24rpx;
  color: #F8FAFC;
  text-align: right;
  flex: 1;
}

.info-val.bold {
  font-weight: 700;
}

.info-val.gold-text {
  color: #C5A880;
  font-weight: 700;
}

.address-text {
  line-height: 1.4;
  word-break: break-all;
}

.opt-b-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #C5A880;
  margin-bottom: 4rpx;
}

.opt-tag-list {
  flex-wrap: wrap;
}

.opt-tag {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.12);
  border: 1rpx solid rgba(197, 168, 128, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  display: inline-flex;
  align-items: center;
}

.opt-tag-img {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(197, 168, 128, 0.4);
  flex-shrink: 0;
}

.item-remark-text {
  font-size: 22rpx;
  color: #F8FAFC;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(197, 168, 128, 0.2);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  line-height: 1.4;
  display: block;
}

/* 汇总账单 */
.summary-breakdown {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(197, 168, 128, 0.2);
}

.b-row {
  margin-bottom: 10rpx;
}

.b-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.b-val {
  font-size: 24rpx;
  color: #F8FAFC;
}

.b-total-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(148, 163, 184, 0.2);
}

.bt-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.bt-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #C5A880;
}

/* 底部操作 (黑曜石高奢) */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(18, 19, 22, 0.96);
  border-top: 1rpx solid rgba(197, 168, 128, 0.25);
  backdrop-filter: blur(16px);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
  gap: 20rpx;
}

.call-store-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  color: #F8FAFC;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.call-store-btn::after {
  border: none;
}

.nav-back-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.nav-back-btn::after {
  border: none;
}
