<!-- 展晨门窗 个人中心 WXML -->
<view class="container">

  <!-- 用户信息头部卡片 -->
  <view class="glass-card user-card flex-between">
    <view class="user-info flex-row">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img-box" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-text-box flex-center">ZC</view>
      <view class="user-meta flex-column">
        <text class="user-name">{{userInfo.nickname || '未登录'}}</text>
        <text class="user-role" wx:if="{{userInfo.phone}}">手机号: {{userInfo.phone}}</text>
        <text class="user-role" wx:else>点击右侧编辑个人信息</text>
      </view>
    </view>
    <view class="user-action-btns flex-column">
      <view class="edit-profile-btn mb-1" bindtap="navToLogin">编辑个人信息</view>
      <view class="address-manage-btn" bindtap="navToAddressList">地址管理</view>
    </view>
  </view>

  <!-- 订单进度快捷入口 (使用专属图片 Icon) -->
  <view class="glass-card order-status-card flex-column">
    <view class="card-header-row flex-between">
      <view class="card-title">我的订单进度</view>
      <view class="total-orders-text">合计：{{orderCounts.total || 0}} 笔订单</view>
    </view>

    <view class="status-grid flex-between">
      <view class="status-item flex-column" bindtap="navToOrders" data-status="pending_review">
        <image class="status-img-icon" src="https://zc-oss.carelife.top/common/icon-pending-review.png" mode="aspectFit"></image>
        <view class="status-label">待复核</view>
        <view class="status-count-badge">{{orderCounts.pending_review || 0}} 笔</view>
      </view>

      <view class="status-item flex-column" bindtap="navToOrders" data-status="producing">
        <image class="status-img-icon" src="https://zc-oss.carelife.top/common/icon-in-production.png" mode="aspectFit"></image>
        <view class="status-label">生产中</view>
        <view class="status-count-badge">{{orderCounts.producing || 0}} 笔</view>
      </view>

      <view class="status-item flex-column" bindtap="navToOrders" data-status="installing">
        <image class="status-img-icon" src="https://zc-oss.carelife.top/common/icon-ing-pickup.png" mode="aspectFit"></image>
        <view class="status-label">待提货</view>
        <view class="status-count-badge">{{orderCounts.installing || 0}} 笔</view>
      </view>

      <view class="status-item flex-column" bindtap="navToOrders" data-status="completed">
        <image class="status-img-icon" src="https://zc-oss.carelife.top/common/icon-completed.png" mode="aspectFit"></image>
        <view class="status-label">已完成</view>
        <view class="status-count-badge">{{orderCounts.completed || 0}} 笔</view>
      </view>
    </view>
  </view>

  <!-- 官方门店联络卡片 -->
  <view class="glass-card store-card flex-column">
    <text class="card-title">联系展晨官方店铺</text>

    <view class="store-row flex-between" bindtap="makePhoneCall">
      <view class="row-left flex-row">
        <text class="row-icon">📞</text>
        <text class="row-label">官方电话</text>
      </view>
      <text class="row-val gold-text">{{storeInfo.phone}} (点击拨打)</text>
    </view>

    <view class="store-row flex-between" bindtap="openStoreLocation">
      <view class="row-left flex-row" style="flex-shrink: 0;">
        <text class="row-icon">📍</text>
        <text class="row-label">门店地址</text>
      </view>
      <view class="row-val address-val flex-row" style="align-items: center; white-space: nowrap; overflow: hidden; max-width: 440rpx; justify-content: flex-end;">
        <text class="gold-text" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{storeInfo.address}}</text>
        <text style="margin-left: 4rpx; flex-shrink: 0;">👈</text>
      </view>
    </view>

    <view class="store-row flex-between">
      <view class="row-left flex-row">
        <text class="row-icon">⏰</text>
        <text class="row-label">营业时间</text>
      </view>
      <text class="row-val">{{storeInfo.business_hours || storeInfo.hours || '08:30 - 18:30'}}</text>
    </view>
  </view>

  <!-- 品牌服务列表 -->
  <view class="glass-card nav-list-card">
    <view class="nav-row flex-between" bindtap="navToAbout">
      <view class="row-left flex-row">
        <text class="row-icon">🏆</text>
        <text class="row-text">关于展晨门窗 (20年品牌资质)</text>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="nav-row flex-between" bindtap="navToContact">
      <view class="row-left flex-row">
        <text class="row-icon">💬</text>
        <text class="row-text">联系我们</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

</view>