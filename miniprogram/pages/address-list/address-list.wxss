/* 展晨门窗 地址管理 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.address-card {
  padding: 24rpx;
  border-radius: 20rpx;
}

.name-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-right: 16rpx;
}

.phone-text {
  font-size: 26rpx;
  color: #C5A880;
  font-weight: 600;
}

.default-badge {
  font-size: 20rpx;
  color: #C5A880;
  background: rgba(197, 168, 128, 0.15);
  border: 1rpx solid rgba(197, 168, 128, 0.35);
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.address-detail-text {
  font-size: 26rpx;
  color: #94A3B8;
  line-height: 1.6;
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.15);
  margin: 20rpx 0 16rpx 0;
}

.card-action-bar {
  align-items: center;
}

.default-radio {
  align-items: center;
}

.radio-circle {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(148, 163, 184, 0.4);
  margin-right: 12rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.radio-circle.checked {
  border-color: #C5A880;
  background: #C5A880;
}

.radio-label {
  font-size: 22rpx;
  color: #94A3B8;
}

.action-btns {
  align-items: center;
}

.action-btn {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.edit-btn {
  color: #CBD5E1;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.del-btn {
  color: #EF4444;
  background: rgba(239, 68, 68, 0.1);
  border: 1rpx solid rgba(239, 68, 68, 0.25);
}

.empty-box {
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #94A3B8;
}

.floating-btn-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(12px);
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  padding: 20rpx 30rpx calc(20rpx + constant(safe-area-inset-bottom));
  z-index: 100;
}

.add-btn {
  width: 100%;
  font-size: 30rpx;
  font-weight: 700;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
}

.mb-3 { margin-bottom: 20rpx; }
.mb-2 { margin-bottom: 12rpx; }