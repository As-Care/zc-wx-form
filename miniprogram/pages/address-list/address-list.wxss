/* 展晨门窗 极奢地址管理 WXSS */

.container {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
}

.address-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(26, 29, 36, 0.85);
  border: 1rpx solid rgba(197, 168, 128, 0.3);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.35);
}

.name-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-right: 16rpx;
}

.phone-text {
  font-size: 26rpx;
  color: #C5A880;
  font-weight: 600;
}

.default-badge {
  font-size: 20rpx;
  color: #121316;
  background: linear-gradient(135deg, #D4AF37 0%, #C5A880 100%);
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
}

.address-detail-text {
  font-size: 26rpx;
  color: #CBD5E1;
  line-height: 1.6;
  margin-top: 14rpx;
}

.detail-str {
  flex: 1;
}

.divider {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.15);
  margin: 24rpx 0 20rpx 0;
}

.card-action-bar {
  align-items: center;
}

.default-radio {
  align-items: center;
  padding: 6rpx 0;
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(197, 168, 128, 0.4);
  margin-right: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.radio-circle.checked {
  border-color: #C5A880;
  background: rgba(197, 168, 128, 0.15);
}

.inner-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C5A880;
}

.radio-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.radio-label.gold {
  color: #C5A880;
  font-weight: 600;
}

.action-btns {
  align-items: center;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.edit-btn {
  color: #E2E8F0;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.del-btn {
  color: #F87171;
  background: rgba(239, 68, 68, 0.12);
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

/* 无图标极简空状态 */
.empty-box {
  align-items: center;
  justify-content: center;
  padding-top: 320rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #F8FAFC;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #64748B;
  text-align: center;
  line-height: 1.6;
}

/* 底部固定按钮栏 (Flexbox 绝对垂直居中) */
.floating-btn-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #121316;
  padding: 16rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx calc(34rpx + constant(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.add-btn {
  width: 100%;
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(197, 168, 128, 0.3);
  margin: 0;
  box-sizing: border-box;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mb-3 { margin-bottom: 24rpx; }
.mb-2 { margin-bottom: 14rpx; }