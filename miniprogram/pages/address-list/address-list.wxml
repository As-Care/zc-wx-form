<!-- 展晨门窗 地址管理列表 WXML -->
<view class="container">

  <view class="address-list flex-column" wx:if="{{addresses && addresses.length > 0}}">
    <view
      class="glass-card address-card mb-3"
      wx:for="{{addresses}}"
      wx:key="id"
      bindtap="selectAddress"
      data-item="{{item}}"
    >
      <view class="card-header flex-between mb-2">
        <view class="user-info flex-row">
          <text class="name-text">{{item.name}}</text>
          <text class="phone-text">{{item.phone}}</text>
        </view>
        <text class="default-badge" wx:if="{{item.is_default}}">默认安装地址</text>
      </view>

      <view class="address-detail-text flex-row">
        <text class="loc-icon">📍</text>
        <text class="detail-str">{{item.province || ''}}{{item.city || ''}}{{item.district || ''}}{{item.detail_address}}</text>
      </view>

      <view class="divider"></view>

      <view class="card-action-bar flex-between" catchtap="preventBubble">
        <view class="default-radio flex-row" bindtap="setDefaultAddress" data-id="{{item.id}}">
          <view class="radio-circle {{item.is_default ? 'checked' : ''}}">
            <view class="inner-dot" wx:if="{{item.is_default}}"></view>
          </view>
          <text class="radio-label {{item.is_default ? 'gold' : ''}}">{{item.is_default ? '已设为默认' : '设为默认'}}</text>
        </view>

        <view class="action-btns flex-row">
          <view class="action-btn edit-btn" bindtap="editAddress" data-item="{{item}}">✏️ 编辑</view>
          <view class="action-btn del-btn" bindtap="deleteAddress" data-id="{{item.id}}">🗑️ 删除</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 精美高奢空状态 -->
  <view class="empty-box flex-column" wx:else>
    <view class="empty-icon-circle flex-center">
      <text class="gold-pin-icon">📍</text>
    </view>
    <text class="empty-title">暂无保存的安装/收货地址</text>
    <text class="empty-sub">添加常用地址后，可在下单时快捷一键选中导入</text>
  </view>

  <!-- 底部固定添加地址按钮 -->
  <view class="floating-btn-bar">
    <button class="add-btn btn-gold" bindtap="navToAddAddress">+ 新增安装/收货地址</button>
  </view>

</view>