<!-- 展晨门窗 地址管理列表 WXML -->
<view class="container">

  <view class="address-list flex-column" wx:if="{{addresses && addresses.length > 0}}">
    <view
      class="glass-card address-card mb-3"
      wx:for="{{addresses}}"
      wx:key="id"
      bindtap="selectAddress"
      data-item="{{item}}"
    >
      <view class="card-header flex-between mb-2">
        <view class="user-info flex-row">
          <text class="name-text">{{item.name}}</text>
          <text class="phone-text">{{item.phone}}</text>
        </view>
        <text class="default-badge" wx:if="{{item.is_default}}">默认地址</text>
      </view>

      <view class="address-detail-text">
        {{item.province || ''}}{{item.city || ''}}{{item.district || ''}}{{item.detail_address}}
      </view>

      <view class="divider"></view>

      <view class="card-action-bar flex-between" catchtap="preventBubble">
        <view class="default-radio flex-row" bindtap="setDefaultAddress" data-id="{{item.id}}">
          <view class="radio-circle {{item.is_default ? 'checked' : ''}}"></view>
          <text class="radio-label">{{item.is_default ? '默认地址' : '设为默认'}}</text>
        </view>

        <view class="action-btns flex-row">
          <view class="action-btn edit-btn" bindtap="editAddress" data-item="{{item}}">编辑</view>
          <view class="action-btn del-btn" bindtap="deleteAddress" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-box flex-column" wx:else>
    <text class="empty-icon">📍</text>
    <text class="empty-title">暂无保存的安装/收货地址</text>
    <text class="empty-sub">添加地址后可在下单时快速选择使用</text>
  </view>

  <!-- 底部固定添加地址按钮 -->
  <view class="floating-btn-bar">
    <button class="add-btn btn-gold" bindtap="navToAddAddress">+ 新增安装/收货地址</button>
  </view>

</view>